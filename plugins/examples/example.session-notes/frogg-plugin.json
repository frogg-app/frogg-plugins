{
  "id": "example.session-notes",
  "name": "Session notes",
  "version": "1.0.0",
  "apiVersion": 1,
  "scope": "hybrid",
  "description": "Hybrid example: a session header action and a markdown panel backed by daemon-side storage",
  "author": "Frogg",
  "entry": { "daemon": "dist/daemon.js", "client": "dist/client.js" },
  "capabilities": ["rpc", "ui.contribute", "settings.store", "agent.read"],
  "contributes": {
    "sessionActions": [{ "id": "example.session-notes.pin", "title": "Pin note" }],
    "panels": [{ "id": "notes", "title": "Session notes", "kind": "markdown" }],
    "settings": [
      {
        "key": "heading",
        "type": "string",
        "title": "Panel heading",
        "default": "Pinned notes"
      }
    ]
  }
}
